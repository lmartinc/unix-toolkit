#!/usr/bin/env bash

###############################################################################
#
# Name        : context
#
# Description : Display system context information
#
###############################################################################

TOOLKIT_HOME="${TOOLKIT_HOME:-${HOME}/.unix-toolkit}"

source "${TOOLKIT_HOME}/lib/common.sh"

###############################################################################
# Main
###############################################################################

main()
{
    show_banner "context"

    printf "Hostname     : %s\n" "$(hostname)"
    printf "User         : %s\n" "$(whoami)"
    printf "Architecture : %s\n" "$(uname -m)"

    case "$(uname -s)" in

        Linux)

            if [[ -f /etc/os-release ]]
            then
                source /etc/os-release
                printf "OS           : %s\n" "${PRETTY_NAME}"
            fi

            ;;

        AIX)

            printf "OS           : AIX\n"
            printf "Version      : %s\n" "$(oslevel -s)"

            ;;

        *)

            printf "OS           : Unknown\n"

            ;;

    esac

    printf "Kernel       : %s\n" "$(uname -r)"
    printf "Shell        : %s\n" "${SHELL:-Unknown}"

    echo
}

main "$@"