#!/usr/bin/env bash

###############################################################################
#
# Name        : network-discover
#
# Description : Discover hosts on a network and generate inventory files.
#
###############################################################################

TOOLKIT_HOME="${TOOLKIT_HOME:-${HOME}/.unix-toolkit}"

source "${TOOLKIT_HOME}/lib/common.sh"

###############################################################################
# Usage
###############################################################################

usage()
{
cat <<EOF

Usage:

    network-discover [subnet]

Examples:

    network-discover
    network-discover 172.25.1.0/24

Description:

    Discover hosts on a network and generate discovery reports.

Default subnet:

    172.25.1.0/24

EOF
}

###############################################################################
# Main
###############################################################################

main()
{
    case "${1:-}" in

        -h|--help)
            usage
            exit 0
            ;;

    esac

    if [[ $# -gt 1 ]]
    then
        usage
        exit 1
    fi

    require_command nmap
    require_command dig
    require_command awk
    require_command sed
    require_command head

    local subnet="${1:-172.25.1.0/24}"
    local subnet_name
    local timestamp
    local output_dir

    subnet_name="$(echo "${subnet}" | tr '/' '_')"
    timestamp="$(date +%Y%m%d_%H%M%S)"

    output_dir="${HOME}/unix-toolkit-data/network/${timestamp}"

    mkdir -p "${output_dir}/nmap"

    local hosts_file="${output_dir}/${subnet_name}_hosts.txt"
    local csv_file="${output_dir}/${subnet_name}_inventory.csv"
    local xml_file="${output_dir}/${subnet_name}.xml"
    local services_file="${output_dir}/services.txt"

    section "Network Discovery"

    echo "Subnet : ${subnet}"
    echo "Output : ${output_dir}"
    echo

    printf "# Generated %s\n" "$(date)" > "${hosts_file}"
    printf "IP,Hostname,MAC,Vendor\n" > "${csv_file}"

    log_info "Running discovery scan..."

    nmap \
        -sn \
        -oX "${xml_file}" \
        "${subnet}" >/dev/null

    local hosts

    hosts="$(nmap -sn "${subnet}" -oG - | awk '/Up$/{print $2}')"

    while read -r ip
    do
        [[ -z "${ip}" ]] && continue

        local hostname
        local mac
        local vendor

        hostname="$(dig +short -x "${ip}" | sed 's/\.$//' | head -1)"
        [[ -z "${hostname}" ]] && hostname="unknown"

        mac="$(nmap -sn "${ip}" | awk '/MAC Address/ {print $3}')"
        vendor="$(nmap -sn "${ip}" | awk -F'[()]' '/MAC Address/ {print $2}')"

        printf "%-15s %s\n" \
            "${ip}" \
            "${hostname}" >> "${hosts_file}"

        printf "%s,%s,%s,%s\n" \
            "${ip}" \
            "${hostname}" \
            "${mac}" \
            "${vendor}" >> "${csv_file}"

        log_ok "${ip} ${hostname}"

    done <<< "${hosts}"

    log_info "Running service scan..."

    nmap \
        -sV \
        -p 22,443,5988,5989 \
        "${subnet}" \
        -oN "${services_file}" >/dev/null

    echo
    log_ok "Discovery completed"

    echo
    echo "Results:"
    echo "    ${output_dir}"
    echo
}

main "$@"