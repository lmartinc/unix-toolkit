#!/usr/bin/env bash

###############################################################################
#
# Name        : mkplaybook
#
# Description : Create a new Ansible playbook
#
###############################################################################

TOOLKIT_HOME="${TOOLKIT_HOME:-${HOME}/.unix-toolkit}"

source "${TOOLKIT_HOME}/lib/common.sh"

###############################################################################
# Usage
###############################################################################

usage()
{
cat <<EOF

Usage:

    mkplaybook <playbook-name>

Example:

    mkplaybook patch_aix

Description:

    Create a new Ansible playbook.

EOF
}

###############################################################################
# Main
###############################################################################

main()
{
    case "${1:-}" in

        -h|--help)
            usage
            exit 0
            ;;

    esac

    if [[ $# -ne 1 ]]
    then
        usage
        exit 1
    fi

    local name="$1"

    #
    # Append .yml if omitted
    #
    [[ "${name}" != *.yml ]] && name="${name}.yml"

    local playbook_dir

    #
    # If inside an Ansible project, use playbooks/
    #
    if [[ -d "./playbooks" ]]
    then
        playbook_dir="./playbooks"
    else
        playbook_dir="."
    fi

    local playbook="${playbook_dir}/${name}"

    if [[ -f "${playbook}" ]]
    then
        log_error "Playbook already exists."
        echo "    ${playbook}"
        exit 1
    fi

    cat > "${playbook}" <<EOF
---
###############################################################################
#
# Name        : ${name}
#
# Description :
#
###############################################################################

- name: ${name%.yml}
  hosts: all
  gather_facts: true
  become: false

  tasks:

    - name: Example task
      ansible.builtin.debug:
        msg: "Hello from ${name%.yml}"
EOF

    log_ok "Created Ansible playbook"

    echo

    if command_exists realpath
    then
        echo "    $(realpath "${playbook}")"
    else
        echo "    ${playbook}"
    fi

    echo
}

main "$@"