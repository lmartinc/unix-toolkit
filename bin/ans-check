#!/usr/bin/env bash

###############################################################################
#
# Name        : ans-check
#
# Description : Validate an Ansible project
#
###############################################################################

source "${HOME}/.unix-toolkit/lib/common.sh"
source "${HOME}/.unix-toolkit/lib/ansible.sh"

PROJECT="$(basename "$PWD")"

CHECKS=0
FAILURES=0

INSTALLED_COLLECTIONS=""

###############################################################################
# Usage
###############################################################################

usage()
{
cat <<EOF

Usage:

    ans-check

Description:

    Validate the current Ansible project.

EOF
}

###############################################################################
# Banner
###############################################################################

show_banner()
{
    echo
    echo "============================================================"
    echo "                 Unix Toolkit - ans-check"
    echo "============================================================"
    echo
    echo "Project   : ${PROJECT}"
    echo "Location  : ${PWD}"
}
###############################################################################
# Check required commands
###############################################################################

check_commands()
{
    section "Required Commands"

    ((CHECKS+=1))
    check_command ansible-playbook || ((FAILURES+=1))

    ((CHECKS+=1))
    check_command ansible-galaxy || ((FAILURES+=1))

    ((CHECKS+=1))
    check_command ansible-lint || ((FAILURES+=1))

    ((CHECKS+=1))
    check_command yamllint || ((FAILURES+=1))
}

###############################################################################
# Check collections
###############################################################################

check_collections()
{
    section "Collections"

    load_installed_collections

    while read -r collection
    do
        [[ -z "${collection}" ]] && continue

        ((CHECKS+=1))

        check_collection "${collection}" || ((FAILURES+=1))

    done < <(get_required_collections)
}

###############################################################################
# Summary
###############################################################################

show_summary()
{
    section "Summary"

    echo "Checks completed : ${CHECKS}"
    echo "Failures         : ${FAILURES}"
    echo

    if (( FAILURES == 0 ))
    then
        log_ok "Project status : HEALTHY"
    else
        log_error "Project status : FAILED"
        exit 1
    fi

    separator
}

###############################################################################
# Main
###############################################################################

main()
{
    local PROJECT

    case "${1:-}" in
        -h|--help)
            usage
            exit 0
            ;;

        "")
            PROJECT="$PWD"
            ;;

        /*)
            PROJECT="$1"
            ;;

        ./*|../*)
            PROJECT="$(realpath "$1")"
            ;;

        *)
            PROJECT="${PROJECTS_HOME}/$1"
            ;;
    esac

    require_directory "${PROJECT}"

    cd "${PROJECT}"

    banner "ans-check"

    echo "Project   : $(basename "$PWD")"
    echo "Location  : $PWD"
    echo

    check_project
    check_commands
    check_collections

    show_summary
}

main "$@"