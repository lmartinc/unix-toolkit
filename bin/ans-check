#!/usr/bin/env bash

###############################################################################
#
# Name        : ans-check
#
# Description : Validate an Ansible project
#
###############################################################################

source "${HOME}/.unix-toolkit/lib/common.sh"
source "${HOME}/.unix-toolkit/lib/ansible.sh"

CHECKS=0
FAILURES=0

###############################################################################
# Usage
###############################################################################

usage()
{
cat <<EOF

Usage:

    ans-check [project]

Description:

    Validate an Ansible project.

Examples:

    ans-check
    ans-check demo
    ans-check /home/lancelot/projects/demo

EOF
}

###############################################################################
# Summary
###############################################################################

show_summary()
{
    section "Summary"

    echo "Checks completed : ${CHECKS}"
    echo "Failures         : ${FAILURES}"
    echo

    if (( FAILURES == 0 ))
    then
        log_ok "Project status : HEALTHY"
    else
        log_error "Project status : FAILED"
        exit 1
    fi

    separator
}

###############################################################################
# Main
###############################################################################

main()
{
    local project

    case "${1:-}" in

        -h|--help)
            usage
            exit 0
            ;;

        "")
            project="$PWD"
            ;;

        /*)
            project="$1"
            ;;

        ./*|../*)
            project="$(realpath "$1")"
            ;;

        *)
            project="${PROJECTS_HOME}/$1"
            ;;

    esac

    require_directory "${project}"

    cd "${project}"

    PROJECT="$(basename "$PWD")"

    show_banner "ans-check"

    check_project
    check_commands
    check_collections

    show_summary
}

main "$@"