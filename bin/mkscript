#!/usr/bin/env bash

###############################################################################
#
# Name        : mkscript
#
# Description : Create a new shell script from the Unix Toolkit template
#
###############################################################################

TOOLKIT_HOME="${TOOLKIT_HOME:-${HOME}/.unix-toolkit}"

source "${TOOLKIT_HOME}/lib/common.sh"

###############################################################################
# Usage
###############################################################################

usage()
{
cat <<EOF

Usage:

    mkscript <script-name>

Example:

    mkscript backup_oracle

Description:

    Create a new shell script using the Unix Toolkit template.

EOF
}

###############################################################################
# Main
###############################################################################

main()
{
    case "${1:-}" in

        -h|--help)
            usage
            exit 0
            ;;

    esac

    if [[ $# -ne 1 ]]
    then
        usage
        exit 1
    fi

    local script_name="$1"
    local template="${TOOLKIT_HOME}/templates/script.sh"

    require_file "${template}"

    if [[ -e "${script_name}" ]]
    then
        log_error "File already exists: ${script_name}"
        exit 1
    fi

    install_file \
        "${template}" \
        "${script_name}"

    sed -i \
        -e "s/__SCRIPT_NAME__/$(basename "${script_name}")/g" \
        -e "s/__DATE__/$(date +%Y-%m-%d)/g" \
        "${script_name}"

    chmod 755 "${script_name}"

    log_ok "Created shell script"

    echo

    if command_exists realpath
    then
        echo "    $(realpath "${script_name}")"
    else
        echo "    $(pwd)/${script_name}"
    fi

    echo
    echo "Next step:"
    echo "    Edit the Description section before using the script."
    echo
}

main "$@"