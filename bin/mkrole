#!/usr/bin/env bash

###############################################################################
#
# Name        : mkrole
#
# Description : Create a new Ansible role
#
###############################################################################

TOOLKIT_HOME="${TOOLKIT_HOME:-${HOME}/.unix-toolkit}"

source "${TOOLKIT_HOME}/lib/common.sh"

###############################################################################
# Usage
###############################################################################

usage()
{
cat <<EOF

Usage:

    mkrole <role-name>

Example:

    mkrole aix_patch

Description:

    Create a new Ansible role structure.

EOF
}

###############################################################################
# Main
###############################################################################

main()
{
    case "${1:-}" in

        -h|--help)
            usage
            exit 0
            ;;

    esac

    if [[ $# -ne 1 ]]
    then
        usage
        exit 1
    fi

    local role="$1"

    if [[ -d "${role}" ]]
    then
        log_error "Role already exists: ${role}"
        exit 1
    fi

    log_info "Creating role ${role}..."

    mkdir -p \
        "${role}/defaults" \
        "${role}/files" \
        "${role}/handlers" \
        "${role}/meta" \
        "${role}/tasks" \
        "${role}/templates" \
        "${role}/tests" \
        "${role}/vars"

    touch \
        "${role}/defaults/main.yml" \
        "${role}/handlers/main.yml" \
        "${role}/meta/main.yml" \
        "${role}/tasks/main.yml" \
        "${role}/vars/main.yml"

    cat > "${role}/README.md" <<EOF
# ${role}

## Description

TODO

## Variables

TODO

## Example

\`\`\`yaml
- name: Example play
  hosts: all

  roles:
    - ${role}
\`\`\`
EOF

    cat > "${role}/tests/inventory" <<EOF
localhost ansible_connection=local
EOF

    cat > "${role}/tests/test.yml" <<EOF
---
- name: Test ${role} role
  hosts: localhost
  connection: local
  become: false

  roles:
    - ${role}
EOF

    log_ok "Created Ansible role"

    echo

    if command_exists realpath
    then
        echo "    $(realpath "${role}")"
    else
        echo "    ${role}"
    fi

    echo
}

main "$@"