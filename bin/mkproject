#!/usr/bin/env bash

###############################################################################
#
# Name        : mkproject
#
# Description : Create a new Ansible project
#
###############################################################################

TOOLKIT_HOME="${TOOLKIT_HOME:-${HOME}/.unix-toolkit}"

source "${TOOLKIT_HOME}/lib/common.sh"

MKROLE="${TOOLKIT_HOME}/bin/mkrole"
MKPLAYBOOK="${TOOLKIT_HOME}/bin/mkplaybook"

###############################################################################
# Usage
###############################################################################

usage()
{
cat <<EOF

Usage:

    mkproject <project-name>

Example:

    mkproject aix_patch

Description:

    Create a new Ansible project.

EOF
}

###############################################################################
# Main
###############################################################################

main()
{
    case "${1:-}" in

        -h|--help)
            usage
            exit 0
            ;;

    esac

    if [[ $# -ne 1 ]]
    then
        usage
        exit 1
    fi

    local project_name="$1"
    local project_dir

    case "${project_name}" in

        /*)
            project_dir="${project_name}"
            ;;

        ./*|../*)
            project_dir="${project_name}"
            ;;

        *)
            project_dir="${PROJECTS_HOME}/${project_name}"
            ;;

    esac

    if [[ -d "${project_dir}" ]]
    then
        log_error "Project already exists: ${project_dir}"
        exit 1
    fi

    log_info "Creating project ${project_dir}..."

    mkdir -p \
        "${project_dir}/docs" \
        "${project_dir}/collections" \
        "${project_dir}/inventory/dev" \
        "${project_dir}/inventory/test" \
        "${project_dir}/inventory/prod" \
        "${project_dir}/group_vars" \
        "${project_dir}/host_vars" \
        "${project_dir}/playbooks" \
        "${project_dir}/roles"

    touch \
        "${project_dir}/inventory/dev/hosts" \
        "${project_dir}/inventory/test/hosts" \
        "${project_dir}/inventory/prod/hosts"

    install_file \
        "${TOOLKIT_HOME}/templates/ansible.cfg" \
        "${project_dir}/ansible.cfg"

    install_file \
        "${TOOLKIT_HOME}/templates/requirements.yml" \
        "${project_dir}/requirements.yml"

    install_file \
        "${TOOLKIT_HOME}/templates/group_vars_all.yml" \
        "${project_dir}/group_vars/all.yml"

    install_file \
        "${TOOLKIT_HOME}/templates/project_README.md" \
        "${project_dir}/README.md"

    replace_text \
        "${project_dir}/README.md" \
        "__PROJECT__" \
        "${project_name}"

    (
        cd "${project_dir}/roles"
        "${MKROLE}" "${project_name}"
    )

    (
        cd "${project_dir}/playbooks"
        "${MKPLAYBOOK}" "${project_name}"
    )

    log_ok "Project created"

    echo

    if command_exists realpath
    then
        echo "    $(realpath "${project_dir}")"
    else
        echo "    ${project_dir}"
    fi

    echo
    echo "Next steps:"
    echo
    echo "    cd ${project_dir}"
    echo "    ansible-galaxy collection install -r requirements.yml"
    echo
}

main "$@"