#!/usr/bin/env bash

###############################################################################
#
# Name        : mkproject
#
# Description : Create a new Ansible project
#
###############################################################################

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "${HOME}/.unix-toolkit/lib/common.sh"

MKROLE="${HOME}/bin/mkrole"
MKPLAYBOOK="${HOME}/bin/mkplaybook"
MKSCRIPT="${HOME}/bin/mkscript"

###############################################################################
# Usage
###############################################################################

usage()
{
cat <<EOF

Usage:

    mkproject <project-name>

Example:

    mkproject aix_patch

EOF
}

###############################################################################
# Main
###############################################################################

main()
{
    case "${1:-}" in
        -h|--help)
            usage
            exit 0
            ;;
    esac

    [[ $# -ne 1 ]] && usage && exit 1

    local PROJECT_NAME="$1"
    local PROJECT_DIR=""

    case "${PROJECT_NAME}" in

        /*)
            PROJECT_DIR="${PROJECT_NAME}"
            ;;

        ./*|../*)
            PROJECT_DIR="${PROJECT_NAME}"
            ;;

        *)
            PROJECT_DIR="${PROJECTS_HOME}/${PROJECT_NAME}"
            ;;

    esac


    if [[ -d "${PROJECT_DIR}" ]]
    then
        log_error "Project already exists: ${PROJECT_DIR}"
        exit 1
    fi


    log_info "Creating project ${PROJECT_DIR}..."

    mkdir -p "${PROJECT_DIR}"

    mkdir -p \
        "${PROJECT_DIR}/docs" \
        "${PROJECT_DIR}/collections" \
        "${PROJECT_DIR}/inventory/dev" \
        "${PROJECT_DIR}/inventory/test" \
        "${PROJECT_DIR}/inventory/prod" \
        "${PROJECT_DIR}/group_vars" \
        "${PROJECT_DIR}/host_vars" \
        "${PROJECT_DIR}/playbooks" \
        "${PROJECT_DIR}/roles"


    touch "${PROJECT_DIR}/inventory/dev/hosts"
    touch "${PROJECT_DIR}/inventory/test/hosts"
    touch "${PROJECT_DIR}/inventory/prod/hosts"


    cp "${TOOLKIT_HOME}/templates/ansible.cfg" \
       "${PROJECT_DIR}/ansible.cfg"

    cp "${TOOLKIT_HOME}/templates/requirements.yml" \
       "${PROJECT_DIR}/requirements.yml"

    cp "${TOOLKIT_HOME}/templates/group_vars_all.yml" \
       "${PROJECT_DIR}/group_vars/all.yml"

    cp "${TOOLKIT_HOME}/templates/project_README.md" \
       "${PROJECT_DIR}/README.md"


    replace_text \
        "${PROJECT_DIR}/README.md" \
        "__PROJECT__" \
        "${PROJECT_NAME}"


    (
        cd "${PROJECT_DIR}/roles"
        ${MKROLE} "${PROJECT_NAME}"
    )


    (
        cd "${PROJECT_DIR}/playbooks"
        ${MKPLAYBOOK} "${PROJECT_NAME}"
    )


    log_ok "Project created"

    echo

    if command_exists realpath
    then
        echo "    $(realpath "${PROJECT_DIR}")"
    else
        echo "    ${PROJECT_DIR}"
    fi


    echo
    echo "Next steps:"
    echo
    echo "    cd ${PROJECT_DIR}"
    echo "    ansible-galaxy collection install -r requirements.yml"
    echo
}


main "$@"