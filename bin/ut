#!/usr/bin/env bash

###############################################################################
#
# Name        : ut
#
# Description : Unix Toolkit command interface
#
###############################################################################

TOOLKIT_HOME="${TOOLKIT_HOME:-${HOME}/.unix-toolkit}"

source "${TOOLKIT_HOME}/lib/common.sh"

###############################################################################
# Usage
###############################################################################

usage()
{
cat <<EOF

Unix Toolkit

Usage:

    ut <command>

Commands:

    version       Display toolkit version and environment
    help          Display this help message

Options:

    -v, --version
    -h, --help

Examples:

    ut version
    ut --version
    ut help

EOF
}

###############################################################################
# Version
###############################################################################

show_version()
{
    section "Unix Toolkit"

    echo "Version    : $(get_version)"
    echo "Platform   : ${PLATFORM:-$(detect_platform)}"
    echo "Toolkit    : ${TOOLKIT_HOME}"
    echo "Projects   : ${PROJECTS_HOME}"
    echo "Repository : ${HOME}/unix-toolkit"

    echo
}

###############################################################################
# Main
###############################################################################

main()
{
    case "${1:-}" in

        version|-v|--version)
            show_version
            ;;

        help|-h|--help|"")
            usage
            ;;

        *)
            log_error "Unknown command: $1"
            echo
            usage
            exit 1
            ;;

    esac
}

main "$@"